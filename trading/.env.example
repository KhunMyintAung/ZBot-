# Copy this file to "trading/.env" and edit.

# paper   = fake money, real Binance prices, no API key needed (START HERE)
# testnet = Binance test exchange, needs TESTNET API key
# live    = REAL MONEY. Also needs LIVE_CONFIRM=YES
MODE=paper
LIVE_CONFIRM=

# spot (long only) | futures (USDT-M, long + short)
MARKET=futures
# One or more coins, comma separated. They share ONE account and one daily kill switch.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
# 15m | 1h | 4h | 1d ...
INTERVAL=4h
# trend | breakout | meanrev | regime
STRATEGY=combo

# ---- Risk (the bot refuses unsafe values) ----
# Per trade. With 4 coins use 0.5 (4 open x 0.5% = 2% at risk at once).
RISK_PCT=0.5
# RISK_PCT x MAX_OPEN_POSITIONS must be <= 4
MAX_OPEN_POSITIONS=4
DAILY_LOSS_PCT=3
MAX_TRADES_PER_DAY=5
LEVERAGE=3
MIN_RR=1.5
MIN_RR_MEANREV=1.0

# ---- Trend strategy ----
# trail = ATR trailing stop, let winners run (tested better on 4h) | fixed = 3 ATR take-profit
TREND_EXIT=trail
TREND_TRAIL_ATR=3
TREND_SL_ATR=1.5
TREND_TP_ATR=3
# 0 = off. 20 = only trade when ADX >= 20
TREND_ADX_MIN=0
# true = EMA200 must slope in the trade direction
TREND_SLOPE=false

# ---- Paper / backtest ----
PAPER_BALANCE=1000
BACKTEST_DAYS=730
# FEE_PCT=0.05        (default: 0.1 spot, 0.05 futures)
# SLIPPAGE_PCT=0.02
POLL_SECONDS=20

# ---- Binance API (testnet or live) ----
# Make the key with: Reading + Spot/Futures trading ON, Withdrawals OFF, IP restriction ON.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Telegram (alerts + AI agent) ----
# Bot token from @BotFather. Chat id: start the agent, send /start to your bot, it replies with the id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Telegram AI agent (node src/index.js agent) ----
# OpenRouter key from openrouter.ai (pay by card or USDC). When set, the agent uses it first.
# Model names: openrouter.ai/models (e.g. openai/gpt-4.1-mini, anthropic/claude-sonnet-...). Cost is counted exactly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OpenAI API key from platform.openai.com. Used when there is no OpenRouter key (it wins over the Claude key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# USD per 1M tokens for the daily budget (set them to your model's prices)
OPENAI_PRICE_IN=0.4
OPENAI_PRICE_OUT=1.6
# Claude API key from console.anthropic.com. Empty (and no OpenAI key) = commands only (/status /pause ...).
ANTHROPIC_API_KEY=
# Optional: free web search + page reading for the agent (agent.tinyfish.ai/api-keys). Empty = off.
TINYFISH_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low | medium | high  (higher = smarter, slower, more expensive)
AGENT_EFFORT=medium
# The agent stops answering (commands still work) when today's AI cost reaches this many USD. 0 = no limit.
AGENT_DAILY_USD=2
# Telegram alert when Binance announces or opens a new coin (alert only, the bot never buys it)
LISTING_ALERTS=true
# FA news to Telegram: important (default) | all | off
NEWS_ALERTS=important
# Community Telegram group (read-only): add the bot to the group, type /groupid there, put the id here.
TELEGRAM_GROUP_ID=
# What the group gets: trades,news,listings
GROUP_SHARE=trades,news,listings
# Real Binance Futures account watch (read-only Telegram warnings): on/off, warn when price is within
# RISK_LIQ_WARN_PCT % of liquidation, or unrealized loss >= RISK_LOSS_WARN_PCT % of the wallet
RISK_WATCH=on
RISK_LIQ_WARN_PCT=10
RISK_LOSS_WARN_PCT=20
# Daily 7 AM picture cards posted straight to the group (others come to you as drafts): crypto,rates (empty = none)
CONTENT_TO_GROUP=crypto
# Fear & Greed filter on new trades (no long in Extreme Greed, no short in Extreme Fear)
FA_FILTER=true
