# Copy this file to ".env" and fill in your keys.

# ---- AI writer ----
# claude (default) | grok | mock (offline test, no API calls)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = better writing, slower, more cost)
# CLAUDE_EFFORT=medium

# Only if AI_PROVIDER=grok
XAI_API_KEY=
# GROK_MODEL=grok-4

# ---- Transcription (Whisper) ----
# Not needed if you put a .srt / .vtt / .txt transcript next to the video with the same name.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Your brand ----
BRAND_NAME=My Podcast
BRAND_AUDIENCE=founders and creators
BRAND_VOICE=direct, specific, a little funny, no corporate buzzwords
NEWSLETTER_NAME=The Weekly

# ---- How many pieces per run ----
CLIPS=8
THREADS=4
LINKEDIN_POSTS=4
QUOTE_CARDS=4
NEWSLETTERS=1
BLOG_POSTS=2
# CLIP_MIN_SECONDS=25
# CLIP_MAX_SECONDS=75

# ---- Schedule ----
# START_DATE=2026-11-16   (default: tomorrow)
# TIMEZONE_LABEL=Asia/Yangon

# ---- Folders ----
# INBOX_DIR=inbox
# OUTPUT_DIR=output
# WATCH_POLL_SECONDS=15
